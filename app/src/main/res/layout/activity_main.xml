<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:background="@drawable/fondo_degradado"
        android:paddingHorizontal="20dp"
        android:paddingVertical="5dp"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:scaleType="fitCenter"
            android:src="@drawable/logo"
            app:tint="@color/white" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:textSize="22dp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_weight="2"
                android:gravity="center_vertical"
                android:text="IPN">
            </TextView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:text="Instituto Politécnico Nacional">
            </TextView>
        </LinearLayout>
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="5dp"
            android:scaleType="centerCrop"
            android:src="@drawable/tizoc"
            app:shapeAppearanceOverlay="@style/ImagenRedonda">
        </com.google.android.material.imageview.ShapeableImageView>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
    </FrameLayout>
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:background="#6e1b45"
        android:layout_height="70dp">
        <Button
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:drawableTop="@drawable/baseline_home_24"
            android:drawableTint="@color/white"
            android:textSize="10dp"
            android:backgroundTint="@android:color/transparent"
            android:layout_height="match_parent"
            android:text="Home"
            android:textColor="@color/white">
        </Button>
        <Button
            android:id="@+id/btnNews"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:drawableTop="@drawable/ic_news"
            android:drawableTint="@color/white"
            android:layout_height="match_parent"
            android:textSize="8dp"
            android:backgroundTint="@android:color/transparent"
            android:text="Noticias"
            android:textColor="@color/white">
        </Button>
        <Button
            android:id="@+id/btnServices"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:drawableTop="@drawable/ic_world"
            android:drawableTint="@color/white"
            android:textSize="8dp"
            android:backgroundTint="@android:color/transparent"
            android:text="Servicios"
            android:textColor="@color/white">
        </Button>
        <Button
            android:id="@+id/btnSchool"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:drawableTop="@drawable/baseline_school_24"
            android:drawableTint="@color/white"
            android:textSize="6dp"
            android:backgroundTint="@android:color/transparent"
            android:text="Académico"
            android:textColor="@color/white">
        </Button>
        <Button
            android:id="@+id/btnProfile"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:drawableTop="@drawable/ic_user"
            android:drawableTint="@color/white"
            android:backgroundTint="@android:color/transparent"
            android:textSize="10dp"
            android:text="Perfil"
            android:textColor="@color/white">
        </Button>
    </LinearLayout>

</LinearLayout>